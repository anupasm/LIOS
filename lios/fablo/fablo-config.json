{
  "$schema": "https://github.com/hyperledger-labs/fablo/releases/download/1.2.0/schema.json",
  "global": {
    "fabricVersion": "2.5.0",
    "tls": true
  },
  "orgs": [
    {
      "organization": {
        "name": "OperatorA",
        "mspName": "OperatorAMSP",
        "domain": "operator-a.lios.example.com"
      },
      "ca": {
        "prefix": "ca"
      },
      "peers": [
        { "name": "peer0", "db": "couchdb" },
        { "name": "peer1", "db": "couchdb" }
      ],
      "orderers": [
        { "name": "orderer0", "consensus": "raft" }
      ]
    },
    {
      "organization": {
        "name": "OperatorB",
        "mspName": "OperatorBMSP",
        "domain": "operator-b.lios.example.com"
      },
      "ca": {
        "prefix": "ca"
      },
      "peers": [
        { "name": "peer0", "db": "couchdb" },
        { "name": "peer1", "db": "couchdb" }
      ],
      "orderers": [
        { "name": "orderer0", "consensus": "raft" }
      ]
    },
    {
      "organization": {
        "name": "OperatorC",
        "mspName": "OperatorCMSP",
        "domain": "operator-c.lios.example.com"
      },
      "ca": {
        "prefix": "ca"
      },
      "peers": [
        { "name": "peer0", "db": "couchdb" },
        { "name": "peer1", "db": "couchdb" }
      ],
      "orderers": [
        { "name": "orderer0", "consensus": "raft" }
      ]
    }
  ],
  "channels": [
    {
      "name": "isl-settlement",
      "orgs": [
        { "name": "OperatorA", "peers": ["peer0", "peer1"] },
        { "name": "OperatorB", "peers": ["peer0", "peer1"] },
        { "name": "OperatorC", "peers": ["peer0", "peer1"] }
      ],
      "endorsementPolicy": "MAJORITY"
    }
  ],
  "chaincodes": [
    {
      "name": "isl-settlement",
      "version": "1.0",
      "lang": "golang",
      "channel": "isl-settlement",
      "directory": "../chaincode/isl_settlement",
      "endorsement": "AND('OperatorAMSP.peer','OperatorBMSP.peer','OperatorCMSP.peer')"
    }
  ]
}
